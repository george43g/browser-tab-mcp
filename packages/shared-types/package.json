{
  "name": "@george43g/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas + hand-mirrored Rust structs for cross-language tool I/O. Includes a drift-check test that parses apps/rust-accel/src/types.rs and fails CI if field names diverge.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@george43g/tsconfig": "workspace:*",
    "@george43g/vitest-config": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
