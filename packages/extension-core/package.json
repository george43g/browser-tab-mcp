{
  "name": "@george43g/extension-core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared WebExtension core for the browser-tab connector extensions (Chrome MV3 + Safari Web Extension): daemon socket client, snapshot/event mappers, command executors.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node ../../scripts/rimraf.mjs dist coverage"
  },
  "dependencies": {
    "@george43g/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@george43g/test-kit": "workspace:*",
    "@george43g/tsconfig": "workspace:*",
    "@george43g/vitest-config": "workspace:*",
    "@types/chrome": "^0.0.280",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7",
    "ws": "^8.21.1"
  }
}
