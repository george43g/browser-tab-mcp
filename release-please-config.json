{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/browser-tab-mcp/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/chrome-extension/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/chrome-extension/public/manifest.json",
          "jsonpath": "$.version"
        }
      ],
      "exclude-paths": ["apps/tmux-control-mcp"]
    },
    "apps/tmux-control-mcp": {
      "release-type": "node",
      "component": "tmux-control",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0"
    }
  },
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "separate-pull-requests": true
}
