{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env.example", "tsconfig.json", "biome.json"],
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "COVERAGE",
    "COVERAGE_GATE",
    "MCP_LOG_DIR",
    "MCP_LOG_RING_SIZE",
    "MCP_LOG_MAX_BYTES",
    "MCP_HEAP_WARN_MB",
    "MCP_HEAP_CHECK_MS",
    "MCP_EVENT_LOOP_SAMPLE_MS",
    "MCP_EVENT_LOOP_WARN_MS",
    "MCP_EVENT_LOOP_KILL_MS",
    "MCP_EVENT_LOOP_SUSTAINED_MS",
    "MCP_EVENT_LOOP_SUSTAINED_SAMPLES",
    "MCP_MEMORY_SAMPLE_MS",
    "MCP_MAX_RSS_MB",
    "MCP_HEAP_GROWTH_SAMPLES",
    "MCP_RESTART_AFTER_MS",
    "MCP_RESTART_QUIET_MS",
    "MCP_IDLE_CHECK_MS",
    "MCP_TOOL_TIMEOUT_DEFAULT_MS",
    "MCP_TOOL_TIMEOUT_FORCE_MS",
    "MCP_RETRY_MAX_ATTEMPTS",
    "MCP_RETRY_BASE_MS",
    "MCP_RETRY_CAP_MS",
    "MCP_RATE_LIMIT_RPS",
    "MCP_RATE_LIMIT_BURST",
    "MCP_WATCHDOG_STATE_PATH",
    "MCP_DISABLE_NATIVE",
    "MCP_DEV",
    "BROWSER_TAB_BROWSERS",
    "BROWSER_TAB_OSA_TIMEOUT_MS",
    "BROWSER_TAB_FAKE_ADAPTER",
    "BROWSER_TAB_POLL_MS",
    "BROWSER_TAB_STATE_DIR",
    "BROWSER_TAB_SOCKET_PATH",
    "BROWSER_TAB_CACHE_DIR",
    "BROWSER_TAB_SNAPSHOT_PATH",
    "BROWSER_TAB_WS_PORT",
    "BROWSER_TAB_TOKEN_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "!dist/**/*.test.*", "*.node", "index.js", "index.d.ts"],
      "inputs": [
        "src/**",
        "vite.config.ts",
        "tsconfig.json",
        "package.json",
        "Cargo.toml",
        "build.rs",
        "$TURBO_ROOT$/scripts/build-stamp.mjs"
      ],
      "env": ["BUILD_STAMP"],
      "passThroughEnv": ["TURBO_HASH"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["src/**", "tests/**", "tsconfig.json"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["src/**", "tests/**", "scripts/**", "biome.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "tests/**",
        "vitest.config.ts",
        "$TURBO_ROOT$/packages/vitest-config/*.ts"
      ]
    },
    "test:no-native": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "src/**",
        "tests/**",
        "vitest.config.ts",
        "$TURBO_ROOT$/packages/vitest-config/*.ts"
      ],
      "env": ["MCP_DISABLE_NATIVE"]
    },
    "stress": {
      "dependsOn": ["build"],
      "outputs": ["stress-mcp-report.json"],
      "inputs": ["src/**", "scripts/stress-mcp.ts"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
