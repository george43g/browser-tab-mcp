{
  "mcpServers": {
    "browser-tab-mcp-dev": {
      "command": "pnpm",
      "args": [
        "tsx",
        "apps/browser-tab-mcp/scripts/mcp-dev-proxy.ts"
      ],
      "env": {
        "MCP_DEV": "1",
        "MCP_DEV_CMD": "pnpm tsx apps/browser-tab-mcp/src/index.ts",
        "MCP_DEV_WATCH_DIR": "apps/browser-tab-mcp/src"
      }
    },
    "mise": {
      "command": "mise",
      "args": [
        "mcp"
      ]
    }
  }
}
