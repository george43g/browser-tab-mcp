{
  "name": "@george43g/chrome-extension",
  "version": "1.9.0",
  "private": true,
  "description": "browser-tab connector — Chrome MV3 extension. Streams tab/window state to the browser-tab daemon over a localhost WebSocket and executes true state-preserving tab moves (chrome.tabs.move). Load dist/ unpacked via chrome://extensions.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-entries.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:no-native": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "node scripts/e2e-channel.mjs chrome",
    "test:e2e:edge": "node scripts/e2e-channel.mjs msedge",
    "clean": "node ../../scripts/rimraf.mjs dist coverage"
  },
  "dependencies": {
    "@george43g/extension-core": "workspace:*",
    "@mozilla/readability": "^0.6.0"
  },
  "devDependencies": {
    "@george43g/test-kit": "workspace:*",
    "@george43g/tsconfig": "workspace:*",
    "@george43g/vitest-config": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/chrome": "^0.0.280",
    "@types/node": "^24.13.3",
    "happy-dom": "^20.11.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.6",
    "vitest": "^3.2.7"
  }
}
