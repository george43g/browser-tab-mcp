#compdef browser-tab
# @generated by usage-cli from .usage.kdl
local curcontext="$curcontext"

_browser_tab() {
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in browser-tab." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_file="${TMPDIR:-/tmp}/usage__usage_spec_browser_tab.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name browser-tab
bin browser-tab
about "browser-tab — MCP server + CLI + TUI (single bin, subcommand dispatch)"
flag --json help="Emit machine-readable JSON output"
flag "-q --quiet" help="Suppress non-error output"
flag "-v --verbose" help="Log debug-level info to stderr"
flag --no-color help="Disable colors"
cmd mcp help="Run the MCP server (stdio default; --http for Streamable HTTP)" {
    flag --http help="Use Streamable HTTP transport (requires MCP_HTTP_TOKEN)"
    flag --port help="HTTP port (default 8080)" {
        arg <port>
    }
    flag --bind help="HTTP bind addr (default 127.0.0.1)" {
        arg <host>
    }
}
cmd tui help="Launch the Ink TUI"
cmd doctor help="Run preflight checks (Node version, native module, config dir)"
cmd repl help="Interactive REPL driving the in-process dispatcher" {
    alias console
}
cmd health help="Print server health snapshot (calls health_check in-process)"
cmd noop help="Demo: call the noop tool" {
    flag --input help="Input string to echo" required=#true {
        arg <text>
    }
    flag --upper help="Return upper-cased"
}
__USAGE_EOF__
  local -a completions=()
  while IFS= read -r line; do
    completions+=("$line")
  done < <(command usage complete-word --shell zsh -f "$spec_file" -- "${words[@]}")
  _describe 'completions' completions -S ''
  return 0
}

if [ "$funcstack[1]" = "_browser_tab" ]; then
    _browser_tab "$@"
else
    compdef _browser_tab browser-tab
fi

