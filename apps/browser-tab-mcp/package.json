{
  "name": "@george43g/browser-tab-mcp",
  "version": "1.2.0",
  "description": "browser-tab — macOS browser-tab detection & management for the yabai/Hammerspoon wm-stack. MCP server + CLI + TUI over a launchd daemon, with a Chrome/Safari connector extension for live tab events and state-preserving cross-window moves.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "bin": {
    "browser-tab": "./dist/cli.js"
  },
  "files": [
    "dist",
    "completions",
    "man",
    "manifest.json",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm build:ts && pnpm build:native:optional",
    "build:ts": "vite build",
    "build:native:optional": "(pnpm --filter @george43g/rust-accel build 2>/dev/null) || (echo '⚠️  Rust native build skipped (rustc not installed or rust-accel missing). TS fallback will be used.' && exit 0)",
    "dev": "vite build --watch",
    "dev:mcp": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/cli.ts mcp",
    "dev:cli": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/cli.ts",
    "dev:tui": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/cli.ts tui",
    "cli": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/cli.js",
    "mcp": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/cli.js mcp",
    "mcp:test": "node --env-file-if-exists=.env.test dist/cli.js mcp",
    "tui": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/cli.js tui",
    "doctor": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/cli.js doctor",
    "test": "vitest run",
    "test:no-native": "MCP_DISABLE_NATIVE=1 vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "stress": "tsx scripts/stress-mcp.ts",
    "stress:tui": "tsx scripts/stress-tui.ts",
    "screenshots": "for f in scripts/screenshots/*.tape; do vhs \"$f\"; done",
    "docs:cli": "mise run docs",
    "completions": "mise run completions",
    "manpage": "mise run manpage",
    "artifacts": "mise run artifacts",
    "completions:install": "bash scripts/install-completions.sh",
    "check:usage": "node scripts/check-usage-freshness.mjs",
    "pack:mcpb": "pnpm build && node scripts/build-mcpb.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "rm -rf dist coverage *.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.0",
    "fullscreen-ink": "^0.1.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "ws": "^8.21.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@george43g/cli-kit": "^2.0.1",
    "@george43g/extension-core": "workspace:*",
    "@george43g/mcp-kit": "workspace:*",
    "@george43g/robustness": "^0.7.0",
    "@george43g/shared-types": "workspace:*",
    "@george43g/test-kit": "workspace:*",
    "@george43g/tsconfig": "workspace:*",
    "@george43g/tui-kit": "^0.4.1",
    "@george43g/vitest-config": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "ink-testing-library": "^4.0.0",
    "rollup-plugin-banner2": "^1.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "mcp",
    "cli",
    "tui"
  ],
  "author": "George G"
}
