# Robustness knobs (MCP_*) — read by @george43g/robustness via envNum/envStr/envBool.

# Logging
MCP_LOG_DIR=
MCP_LOG_RING_SIZE=500
MCP_LOG_MAX_BYTES=10485760
MCP_LOG_PREFIX=browser-tab-mcp

# Heap monitor
MCP_HEAP_WARN_MB=150
MCP_HEAP_CHECK_MS=60000

# Watchdog: event-loop lag
MCP_EVENT_LOOP_SAMPLE_MS=5000
MCP_EVENT_LOOP_WARN_MS=500
MCP_EVENT_LOOP_KILL_MS=10000
MCP_EVENT_LOOP_SUSTAINED_MS=750
MCP_EVENT_LOOP_SUSTAINED_SAMPLES=6

# Watchdog: memory
MCP_MEMORY_SAMPLE_MS=60000
MCP_MAX_RSS_MB=1024
MCP_HEAP_GROWTH_SAMPLES=10

# Watchdog: idle / uptime restart
MCP_RESTART_AFTER_MS=86400000
MCP_RESTART_QUIET_MS=3600000
MCP_IDLE_CHECK_MS=600000

# Watchdog: external observer state file
# When set, the watchdog writes a JSON snapshot per tick. Used by CI stress
# harness; safe to leave unset in production.
MCP_WATCHDOG_STATE_PATH=

# Per-tool timeouts (ms). 0 disables. Per-tool overrides live in
# src/tools/registry.ts.
MCP_TOOL_TIMEOUT_DEFAULT_MS=30000
# Set this to force every tool to time out at the given ms — incident knob.
MCP_TOOL_TIMEOUT_FORCE_MS=

# Retry helper defaults
MCP_RETRY_MAX_ATTEMPTS=3
MCP_RETRY_BASE_MS=500
MCP_RETRY_CAP_MS=8000

# Token-bucket rate limiter (set RPS=0 to disable)
MCP_RATE_LIMIT_RPS=10
MCP_RATE_LIMIT_BURST=30

# HTTP transport (only used when running `browser-tab-cli http` or `browser-tab-mcp --http`)
# Generate the token with: openssl rand -hex 32
MCP_HTTP_TOKEN=
MCP_HTTP_PORT=8080
MCP_HTTP_BIND=127.0.0.1

# Native acceleration toggle (set to 1 to force TS fallback path)
MCP_DISABLE_NATIVE=

# Dev mode — registers the `get_logs` tool. NEVER set this in production.
MCP_DEV=

# TUI theme — "safe" (default, no Nerd Font required) or "powerline"
MCP_TUI_THEME=safe
# TUI accent color hex (drives the derived palette)
MCP_TUI_ACCENT=#1982FC
