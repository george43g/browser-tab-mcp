# browser-tab — every environment variable this repo recognizes, with its
# default. Copy to `.env` (gitignored) and edit; precedence is
# `.env` → `.env.local` → `.env.[mode]` → `.env.[mode].local` (AGENTS.md § Env layout).
#
# THIS FILE IS THE EXHAUSTIVE LIST. If you add a `process.env.X` or an
# `envNum/envStr/envBool("X")` read anywhere in `apps/` or `packages/`, add it
# here in the same commit — this is the only place the full set is written down.
# Ten of these are also CLI flags (`src/env-flags.ts`); the rest are env-only by
# design. Vars marked "ambient" are conventions this tool HONORS but does not
# own — don't set them here, they come from your shell or CI.
#
# Verify completeness:
#   grep -rhoE '(process\.env\.[A-Z_]+|env(Num|Bool|Str)\("[A-Z_]+")' apps packages \
#     | sed -E 's/.*"([A-Z_]+)".*/\1/; s/process\.env\.//' | sort -u

# Robustness knobs (MCP_*) — read by @george43g/robustness via envNum/envStr/envBool.

# Logging
MCP_LOG_DIR=
MCP_LOG_RING_SIZE=500
MCP_LOG_MAX_BYTES=10485760
MCP_LOG_PREFIX=browser-tab-mcp

# Heap monitor
MCP_HEAP_WARN_MB=150
MCP_HEAP_CHECK_MS=60000

# Watchdog: event-loop lag
MCP_EVENT_LOOP_SAMPLE_MS=5000
MCP_EVENT_LOOP_WARN_MS=500
MCP_EVENT_LOOP_KILL_MS=10000
MCP_EVENT_LOOP_SUSTAINED_MS=750
MCP_EVENT_LOOP_SUSTAINED_SAMPLES=6

# Watchdog: memory
MCP_MEMORY_SAMPLE_MS=60000
MCP_MAX_RSS_MB=1024
MCP_HEAP_GROWTH_SAMPLES=10

# Watchdog: idle / uptime restart
MCP_RESTART_AFTER_MS=86400000
MCP_RESTART_QUIET_MS=3600000
MCP_IDLE_CHECK_MS=600000

# Watchdog: external observer state file
# When set, the watchdog writes a JSON snapshot per tick. Used by CI stress
# harness; safe to leave unset in production.
MCP_WATCHDOG_STATE_PATH=

# Tool timeouts (ms). 0 disables. This is the FALLBACK only: a tool sets its own
# budget via `timeoutMs` on its ToolDefinition (e.g. src/tools/focus-tab.ts).
# There is no central timeout table.
MCP_TOOL_TIMEOUT_DEFAULT_MS=30000
# Set this to force every tool to time out at the given ms — incident knob;
# overrides both the default and any per-tool timeoutMs.
MCP_TOOL_TIMEOUT_FORCE_MS=

# Retry helper defaults
MCP_RETRY_MAX_ATTEMPTS=3
MCP_RETRY_BASE_MS=500
MCP_RETRY_CAP_MS=8000

# Token-bucket rate limiter (set RPS=0 to disable)
MCP_RATE_LIMIT_RPS=10
MCP_RATE_LIMIT_BURST=30

# Browser detection engine
# Comma list of browsers to scan: chrome|chromium|brave|edge|safari
BROWSER_TAB_BROWSERS=chrome,chromium,brave,edge,safari
# Hard bound on every osascript call (browsers can wedge Apple Events)
BROWSER_TAB_OSA_TIMEOUT_MS=5000
# Test hook: replace real adapters with deterministic fixtures (tests/stress)
BROWSER_TAB_FAKE_ADAPTER=

# Scale the fake adapter UP (0 = off, keeping the default fixtures byte-identical).
# `SCALE` windows per browser, `TABS` tabs each, with long realistic titles.
# Exists for the TUI stress harness: the default fixture titles ("Inbox (3) -
# Gmail") never reach a width budget, so rendering them measures the fixture
# rather than the layout — which is how the row-overflow bug shipped past a
# green suite.
BROWSER_TAB_FAKE_SCALE=0
BROWSER_TAB_FAKE_TABS=40

# Platform override — "macos" | "windows" | "linux" (default: this OS).
# Gates the macOS-only paths: AppleScript adapters, cgWindowId correlation,
# `screencapture -l`, and the launchd-vs-Task-Scheduler choice. Exists so every
# platform branch is testable from one machine; setting it in real use will
# make the daemon claim capabilities it does not have.
BROWSER_TAB_PLATFORM=

# Keep basic-auth userinfo (user:pass@) in snapshot/journal/history URLs.
# Default 0: the daemon redacts credentials out of recorded URLs, because a
# tab like http://admin:secret@192.168.1.1/ otherwise carries a live password
# into snapshot files, journals, logs and any agent's context. This escape
# only affects the daemon-side layer (AppleScript/Safari/history sources) —
# a current connector extension redacts at its own mapper regardless.
BROWSER_TAB_KEEP_URL_USERINFO=

# HTTP interface port. UNSET/0 = the server is never started (opt-in by
# design — a default port would mean an upgrade silently starts listening on a
# machine whose owner never asked). Binds 127.0.0.1 only; every route needs the
# daemon token as `Authorization: Bearer` (see docs/agent-handoff/DECISIONS.md).
BROWSER_TAB_HTTP_PORT=
# Daemon
# Poll interval for AppleScript scans (extension-fed browsers relax to 6x this)
BROWSER_TAB_POLL_MS=5000
# State dir (IPC endpoint, extension token, pid file).
# Default ~/.browser-tab; on Windows %LOCALAPPDATA%\browser-tab\state
BROWSER_TAB_STATE_DIR=
# IPC endpoint override. Default $BROWSER_TAB_STATE_DIR/daemon.sock;
# on Windows a named pipe, \\.\pipe\browser-tab-<user>
BROWSER_TAB_SOCKET_PATH=
# Snapshot cache dir for shell consumers. Default ~/.cache/browser-tab
BROWSER_TAB_CACHE_DIR=
# Full snapshot file path override. Default $BROWSER_TAB_CACHE_DIR/snapshot.json
BROWSER_TAB_SNAPSHOT_PATH=
# Liveness beacon path override. Default $BROWSER_TAB_CACHE_DIR/heartbeat.json
# Written at the end of every completed engine tick (cadence = BROWSER_TAB_POLL_MS)
# and removed on a clean stop — shell consumers stat it instead of forking the CLI.
BROWSER_TAB_HEARTBEAT_PATH=
# Extension WebSocket server port (127.0.0.1 only)
BROWSER_TAB_WS_PORT=8790
# Extension auth token file. Default $BROWSER_TAB_STATE_DIR/extension-token
BROWSER_TAB_TOKEN_PATH=

# Focus/navigation journal — event-sourced history of window/tab focus + navigation.
# Directory for the ndjson rings. Default $BROWSER_TAB_CACHE_DIR/journal
BROWSER_TAB_JOURNAL_DIR=
# In-memory ring size per log (focus + nav). Default 2000
BROWSER_TAB_JOURNAL_RING=2000
# Rotate an ndjson file once it exceeds this many bytes (keeps one prior gen). Default 5MiB
BROWSER_TAB_JOURNAL_MAX_BYTES=5242880

# Page content & state — on-demand extraction + capture-on-blur.
# Capture the prev-tab state on a tab switch (blur capture); pushed to the extension via helloAck. Default 1
BROWSER_TAB_BLUR_CAPTURE=1
# Cap extracted reader-mode text at this many bytes (enforced in the injected extractor). Default 200KiB
BROWSER_TAB_EXTRACT_MAX_BYTES=204800
# Tighten the extension WebSocket max frame size (ws default is 100MB). Default 16MiB
BROWSER_TAB_WS_MAX_PAYLOAD=16777216
# Max cached extracted pages before file-count LRU eviction. Default 200
BROWSER_TAB_CONTENT_MAX=200
# Max bytes for an inline data: favicon before it's dropped from the snapshot
# (http(s) favicon URLs always pass). Capped at the source (extension); the
# daemon re-applies this and can only tighten it. Default 4KiB
BROWSER_TAB_FAVICON_MAX_BYTES=4096
# Content cache dir / annotation store path. Default $BROWSER_TAB_CACHE_DIR/content · /annotations.ndjson
BROWSER_TAB_CONTENT_DIR=
BROWSER_TAB_ANNOTATIONS_PATH=

# Screenshots — tier 1 (extension captureVisibleTab) + tier 2 (daemon screencapture).
# Enable tier-2 window capture (`screencapture -l <cgWindowId>`, any visible window).
# Needs Screen Recording permission (check `browser-tab doctor`). Default 0 (off).
BROWSER_TAB_WINDOW_CAPTURE=0
# jpeg quality (0–100) for captured shots. Default 70
BROWSER_TAB_SHOT_QUALITY=70
# Max cached jpeg shots before file-count LRU eviction. Default 200
BROWSER_TAB_SHOT_MAX=200
# Shot cache dir. Default $BROWSER_TAB_CACHE_DIR/shots
BROWSER_TAB_SHOT_DIR=
# Override the screencapture binary (tests point this at a fixture-writing shim).
# Default /usr/bin/screencapture
BROWSER_TAB_SCREENCAPTURE_BIN=
# Log directory override. Default ~/Library/Logs/browser-tab (macOS),
# %LOCALAPPDATA%\browser-tab\logs (Windows), ~/.local/state/... elsewhere
BROWSER_TAB_LOG_DIR=
# schtasks(1) binary — the Windows `daemon install` seam, for tests. Default schtasks
BROWSER_TAB_SCHTASKS_BIN=

# Global history — Chrome-family via the extension (chrome.history), Safari via
# a daemon-side sqlite read of History.db.
# Enable reading Safari's History.db. Needs Full Disk Access (check `browser-tab
# doctor`) — it exposes the full browsing history. Default 0 (off).
BROWSER_TAB_SAFARI_HISTORY=0
# Override the sqlite3 binary (tests point this at a fixture-emitting shim).
# Default /usr/bin/sqlite3
BROWSER_TAB_SQLITE_BIN=

# Override the yabai binary used for cgWindowId correlation — tier-2 window
# ids/frames, and the per-window titles that break bounds ties under tiling.
# Tests point this at a fixture-emitting shim. Default: the first of
# /opt/homebrew/bin/yabai, /usr/local/bin/yabai, yabai that answers.
BROWSER_TAB_YABAI_BIN=
# Verbose cgWindowId correlation diagnostics: makes cg_correlate log on every
# correlation pass, not just when an id degrades. cg_merge_trigger exists
# ONLY under this knob — it never fires on its own. Default 0 (off).
BROWSER_TAB_CG_DIAG=0
# Override the Safari History.db path (default ~/Library/Safari/History.db).
BROWSER_TAB_SAFARI_HISTORY_DB=

# Native acceleration toggle (set to 1 to force TS fallback path)
MCP_DISABLE_NATIVE=

# Dev mode — registers the `get_logs` tool. NEVER set this in production.
MCP_DEV=
# Skip registering MCP resources entirely (set to 1). Resources are otherwise
# wired whenever MCP_DEV=1 or NODE_ENV=development.
MCP_DISABLE_RESOURCES=

# TUI theme — "safe" (default, no Nerd Font required) or "powerline"
MCP_TUI_THEME=safe
# TUI accent color hex (drives the derived palette)
MCP_TUI_ACCENT=#1982FC

# Dev MCP proxy (scripts/mcp-dev-proxy.ts) — restarts the child on source change.
# Child command to run. Default "tsx src/index.ts"
MCP_DEV_CMD=
# Directory watched recursively for restarts. Default "src"
MCP_DEV_WATCH_DIR=

# Test/CI hooks — set by the harnesses, not normally by hand.
# Artificial delay (ms) inside the `noop` tool, so timeout paths are testable.
MCP_TEST_NOOP_DELAY_MS=
# Collect coverage (1) · additionally FAIL under the per-package threshold (1).
COVERAGE=
COVERAGE_GATE=
# TUI soak harness (scripts/stress-tui.ts + stress-tui-workload.ts).
STRESS_DURATION_S=30
STRESS_RSS_FAIL_MB=800
STRESS_LAG_FAIL_MS=2000
WORKLOAD_DURATION_S=60

# ── Ambient conventions (honored, NOT owned — do not set them here) ──
# NODE_ENV            "development" enables MCP resources; also the env-loader's
#                     default mode when none is passed.
# NO_COLOR            any value disables ANSI color (https://no-color.org).
# FORCE_COLOR         any value forces color on even when stdout isn't a TTY.
# CI                  truthy ⇒ non-interactive: output defaults to JSON and the
#                     TUI/REPL refuse to start. GITHUB_ACTIONS, GITLAB_CI,
#                     CIRCLECI, TRAVIS, BUILDKITE and CONTINUOUS_INTEGRATION are
#                     accepted as equivalents (@george43g/cli-kit `tty.ts`).
# NAPI_RS_*           read by the napi-generated apps/rust-accel/index.js loader.
# EXT_ENTRY           per-entry selector for the extension's Vite build; set by
#                     apps/chrome-extension's build script, never by a user.

# Extra URL schemes `open_tab` / `open_window` / `tab_action navigate` may open,
# comma-separated (e.g. "file,data"). Default allows http, https, about and the
# browser-internal schemes (chrome:, chrome-extension:, brave:, edge:, ...).
# javascript: and file: are REFUSED by default on purpose: the caller is usually
# a model that has just read untrusted web content, and those two turn a tab
# tool into script execution and local-file disclosure respectively.
BROWSER_TAB_ALLOW_URL_SCHEMES=
