// usage spec — drives completions (bash/zsh/fish/pwsh) + manpage + markdown docs.
// Generate: `usage g completion <shell> -f .usage.kdl`, `usage g markdown -f .usage.kdl -m --out-dir <dir>/`.
// Docs: https://usage.jdx.dev/spec
//
// Keep this in sync with the commander program in src/cli.ts.

name "browser-tab"
bin "browser-tab"
about "browser-tab — MCP server + CLI + TUI (single bin, subcommand dispatch)"

flag "--json" help="Emit machine-readable JSON output"
flag "-q --quiet" help="Suppress non-error output"
flag "-v --verbose" help="Log debug-level info to stderr"
flag "--no-color" help="Disable colors"

// The curated env-var ↔ flag contract (src/env-flags.ts). A flag always beats
// the corresponding env var. Every OTHER recognized env var is env-only and
// documented in .env.example — this list is deliberately short.
flag "--log-dir" help="Directory for NDJSON logs (MCP_LOG_DIR)" {
    arg "<dir>"
}
flag "--disable-native" help="Force the TS path, skipping the native module (MCP_DISABLE_NATIVE)"
flag "--socket-path" help="Daemon unix socket path (BROWSER_TAB_SOCKET_PATH)" {
    arg "<path>"
}
flag "--ws-port" help="Extension WebSocket port on 127.0.0.1 (BROWSER_TAB_WS_PORT)" {
    arg "<port>"
}
flag "--state-dir" help="Daemon state dir: token, journals (BROWSER_TAB_STATE_DIR)" {
    arg "<dir>"
}
flag "--cache-dir" help="Snapshot/content/screenshot cache dir (BROWSER_TAB_CACHE_DIR)" {
    arg "<dir>"
}
flag "--browsers" help="Comma-separated browsers to poll (BROWSER_TAB_BROWSERS)" {
    arg "<list>"
}
flag "--poll-ms" help="AppleScript poll interval in ms (BROWSER_TAB_POLL_MS)" {
    arg "<ms>"
}
flag "--fake-adapter" help="Use the fake adapter, no real browsers (BROWSER_TAB_FAKE_ADAPTER)"
flag "--dev" help="Enable dev-only tools such as get_logs (MCP_DEV)"

cmd "mcp" help="Run the MCP server (stdio)"

cmd "tui" help="Launch the Ink TUI"

cmd "doctor" help="Run preflight checks (Node version, native module, config dir)"

cmd "repl" help="Interactive REPL driving the in-process dispatcher" {
    alias "console"
}

cmd "health" help="Print server health snapshot (calls health_check in-process)"

cmd "bookmark" help="Read or edit bookmarks (search|list|create|update|remove) — needs daemon + extension" {
    alias "bm"
    arg "<action>" help="search | list | create | update | remove"
    flag "--browser" help="Which browser (required when >1 extension is connected)" {
        arg "<name>"
    }
    flag "--query" help="search: substring over title and URL" {
        arg "<text>"
    }
    flag "--folder" help="list: folder to read (omit for the root)" {
        arg "<id>"
    }
    flag "--recursive" help="list: flatten the whole subtree"
    flag "--id" help="update/remove: node to act on" {
        arg "<id>"
    }
    flag "--parent" help="create: destination folder" {
        arg "<id>"
    }
    flag "--title" help="create/update: title (create with no --url makes a folder)" {
        arg "<title>"
    }
    flag "--url" help="create/update: target URL" {
        arg "<url>"
    }
    flag "--limit" help="Max rows" {
        arg "<n>"
    }
}

cmd "logs" help="Show recent daemon/server log lines (dev-only: needs MCP_DEV=1)" {
    flag "--source" help="memory (ring buffer) | file (NDJSON on disk) | all" {
        arg "<src>"
    }
    flag "--tail" help="How many lines (1-500)" {
        arg "<n>"
    }
}

cmd "list" help="List open browser windows and tabs (Chrome/Brave/Chromium/Edge/Safari)" {
    flag "--browser" help="Restrict to one browser: chrome|chromium|brave|edge|safari" {
        arg "<name>"
    }
    flag "--window" help="Restrict to one window (opaque windowId)" {
        arg "<id>"
    }
    flag "--url" help="Filter tabs by URL substring" {
        arg "<substring>"
    }
    flag "--fields" help="Field set: summary (no tab rows), core (trimmed) or full" {
        arg "<set>" default="full" {
            choices "core" "full"
        }
    }
}

cmd "reload-extension" help="Restart a browser's connector extension from disk (dev deploy loop)" {
    flag "--browser" help="Which browser's extension to reload" {
        arg "<name>" default="chrome" {
            choices "chrome" "chromium" "brave" "edge" "safari"
        }
    }
}

cmd "select" help="Resolve a control-language selector against the live snapshot (needs daemon)" {
    flag "--selector" required=#true help="Selector AST as JSON; @<file> reads a file, - reads stdin" {
        arg "<json>"
    }
    flag "--projection" help="Result shape" {
        arg "<p>" default="core" {
            choices "core" "ids" "count"
        }
    }
}

cmd "apply" help="Apply a live-layout plan from browser-tab plan (needs daemon + extension)" {
    flag "--plan" required=#true help="planId from plan_tab_change (must still be current)" {
        arg "<id>"
    }
}

cmd "copy" help="Reconstruct selected tabs at a destination; sources stay open (needs daemon)" {
    flag "--selector" help="Selector AST as JSON; @<file> or - for stdin" {
        arg "<json>"
    }
    flag "--selection" help="A current select_tabs selectionId (instead of --selector)" {
        arg "<id>"
    }
    flag "--to-window" help="Copy into an existing window" {
        arg "<windowId>"
    }
    flag "--new-window" help="Copy into a new window in this browser" {
        arg "<browser>"
    }
    flag "--idempotency-key" help="Retry-safe: same key replays the stored outcome" {
        arg "<key>"
    }
}

cmd "plan" help="Plan one tab transform without applying it (needs daemon)" {
    flag "--selector" help="Selector AST as JSON; @<file> or - for stdin" {
        arg "<json>"
    }
    flag "--selection" help="A current select_tabs selectionId (instead of --selector)" {
        arg "<id>"
    }
    flag "--transform" required=#true help="Transform as JSON; @<file> or - for stdin" {
        arg "<json>"
    }
    flag "--pin-policy" help="Pinned members policy" {
        arg "<p>" {
            choices "skip"
        }
    }
}

cmd "journal" help="Show recorded focus/navigation history" {
    flag "--view" help="Which journal view to show" {
        arg "<view>" default="recent" {
            choices "windowMru" "tabMru" "journey" "recent"
        }
    }
    flag "--browser" help="Restrict to one browser" {
        arg "<name>"
    }
    flag "--window" help="Window handle (required for tabMru)" {
        arg "<id>"
    }
    flag "--tab" help="Tab handle (required for journey)" {
        arg "<id>"
    }
    flag "--limit" help="Max records" {
        arg "<n>"
    }
}

cmd "history" help="Query the browser's global URL history (Chrome-family; Safari opt-in)" {
    flag "--browser" help="Limit to one browser (omit to merge all reachable sources)" {
        arg "<name>"
    }
    flag "--query" help="Case-insensitive substring filter on URL/title" {
        arg "<text>"
    }
    flag "--start" help="Only visits at/after this epoch ms" {
        arg "<ms>"
    }
    flag "--end" help="Only visits at/before this epoch ms" {
        arg "<ms>"
    }
    flag "--limit" help="Max rows" {
        arg "<n>"
    }
}

cmd "page" help="Extract a tab's content or live state (needs daemon + extension)" {
    arg "<tabId>"
    flag "--mode" help="text | metadata | state" {
        arg "<mode>"
    }
    flag "--force" help="Bypass the navEpoch cache and re-extract"
}

cmd "annotate" help="Read or write a URL-keyed note in the daemon annotation store" {
    arg "<url>"
    flag "--note" help="Note to store (omit to read the existing note)" {
        arg "<text>"
    }
}

cmd "screenshot" help="Capture a tab or window as a jpeg (needs the daemon + extension for tabs)" {
    arg "<id>"
    flag "--window" help="Treat <id> as a window handle: tier 2 screencapture (opt-in)"
    flag "--focus" help="Tier 'tab': activate the tab first if it isn't active (changes user state)"
    flag "--force" help="Bypass the navEpoch shot cache and recapture"
    flag "--out" help="Copy the captured jpeg to this path" {
        arg "<file>"
    }
}

cmd "focus" help="Focus a tab and raise its window" {
    arg "<tabId>"
    flag "--no-raise" help="Activate the tab without raising or un-minimizing its window"
}

cmd "close" help="Close a tab" {
    arg "<tabId>"
}

cmd "open" help="Open an http(s) URL in a new tab" {
    arg "<url>"
    flag "--browser" help="chrome|chromium|brave|edge|safari" {
        arg "<name>"
    }
    flag "--window" help="Open in a specific window (opaque windowId)" {
        arg "<id>"
    }
    flag "--no-activate" help="Open in the background"
}

cmd "move" help="Move a tab within its window (--to/--by) or to another (true moves need daemon + extension)" {
    arg "<tabId>"
    flag "--target-window" help="Destination windowId" {
        arg "<id>"
    }
    flag "--index" help="0-based destination position (legacy; prefer --to)" {
        arg "<n>"
    }
    flag "--to" help="Signed one-based position: 1 = first, -1 = last (same-window without --target-window)" {
        arg "<pos>"
    }
    flag "--by" help="Signed relative displacement within the tab's own window (e.g. -1, 3)" {
        arg "<n>"
    }
    flag "--new-window" help="Move into a newly created window"
    flag "--allow-reload" help="Safari: accept the reload-based AppleScript move"
}

cmd "act" help="Run an action on a tab (mute|unmute|pin|unpin|discard|reload|navigate|back|forward|duplicate)" {
    arg "<tabId>"
    arg "<action>"
    flag "--url" help="Destination URL (required for navigate)" {
        arg "<url>"
    }
}

cmd "group" help="Manage Chrome tab groups (create|add|remove|update|move)" {
    arg "<action>"
    flag "--tabs" help="Comma-separated tab handles (create/add/remove)" {
        arg "<ids>"
    }
    flag "--group" help="Group handle (add/remove/update/move)" {
        arg "<id>"
    }
    flag "--browser" help="chrome|chromium|brave|edge" {
        arg "<name>"
    }
    flag "--title" help="Group title (create/update)" {
        arg "<title>"
    }
    flag "--color" help="Group color (create/update)" {
        arg "<color>"
    }
    flag "--collapsed" help="Collapse the group (update)"
    flag "--target-window" help="Destination window (move)" {
        arg "<id>"
    }
    flag "--index" help="0-based destination position (move)" {
        arg "<n>"
    }
}

cmd "window" help="Window operations: open | set | close" {
    cmd "open" help="Open a new window with one or more URLs" {
        arg "<url>" var=#true
        flag "--browser" help="chrome|chromium|brave|edge|safari" {
            arg "<name>"
        }
        flag "--bounds" help="Global-coordinate frame x,y,w,h" {
            arg "<bounds>"
        }
        flag "--display" help="0-based display index (fills that monitor)" {
            arg "<n>"
        }
        flag "--state" help="normal|minimized|maximized|fullscreen" {
            arg "<state>"
        }
        flag "--incognito" help="Open a private/incognito window"
        flag "--no-focus" help="Open in the background"
    }
    cmd "set" help="Move/resize/minimize/foreground a window" {
        arg "<windowId>"
        flag "--bounds" help="Global-coordinate frame x,y,w,h" {
            arg "<bounds>"
        }
        flag "--display" help="0-based display index (fills that monitor)" {
            arg "<n>"
        }
        flag "--state" help="normal|minimized|maximized|fullscreen" {
            arg "<state>"
        }
        flag "--focus" help="Raise/foreground the window"
    }
    cmd "close" help="Close an entire window and all its tabs" {
        arg "<windowId>"
    }
}

cmd "daemon" help="Manage the browser-tab daemon" {
    cmd "run" help="Run the daemon in the foreground (launchd invokes this)"
    cmd "install" help="Install + start the launchd LaunchAgent"
    cmd "uninstall" help="Stop + remove the launchd LaunchAgent"
    cmd "status" help="Show launchd + live daemon status"
    cmd "token" help="Print the extension auth token"
    cmd "stop" help="Stop the daemon (launchctl bootout)"
    cmd "restart" help="Restart the daemon (launchctl kickstart -k)"
}

cmd "noop" help="Demo: call the noop tool" {
    flag "--input" required=#true help="Input string to echo" {
        arg "<text>"
    }
    flag "--upper" help="Return upper-cased"
}
