#!/bin/sh
# Runs the macOS checks more strictly than CI does.
#
# ci.yml HAS a macos-latest leg again — conditional on this repo being public
# (free on public repos; 10x billing killed it while private, and it dies again
# the day the repo goes private — see the matrix comment in ci.yml). This hook
# stays either way because it does what no runner leg does: it LOADS the built
# `.node` and calls listCgWindows()/listDisplays() for real, rather than just
# compiling the `#[cfg(target_os = "macos")]` CoreGraphics code.
#
# It is deliberately NOT the whole bar: lint, typecheck, stress, coverage and
# the Windows leg all still run in CI, and duplicating them here would make
# pushing slow enough that people reach for --no-verify by reflex.
#
# Escape hatch: `git push --no-verify`.
exec node "$(git rev-parse --show-toplevel)/scripts/verify-macos.mjs"
